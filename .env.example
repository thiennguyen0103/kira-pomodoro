# Prisma Postgres TCP connection string from `npx create-db`.
# Copy this file to .env. Do not commit .env.
#
# Use a standard postgres:// URL. Do not use prisma+postgres://.
#
# Next.js loads .env, .env.local, .env.development, and .env.production
# from the project root (not from src/).
# Prisma CLI loads .env through dotenv in prisma.config.ts.
#
# Never put secrets in NEXT_PUBLIC_* variables. Those are inlined into
# browser JavaScript.

DATABASE_URL="postgres://..."

# Better Auth. Keep these server-side. Do not prefix them with NEXT_PUBLIC_.
# BETTER_AUTH_SECRET must be at least 32 random characters.
# Local callback: http://localhost:3000/api/auth/callback/google
# Review callback: https://<review-host>/api/auth/callback/google
# AUTH_TRUSTED_ORIGINS is a comma-separated list of this app's own origins.
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-random-string-of-at-least-32-characters"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AUTH_TRUSTED_ORIGINS=""
